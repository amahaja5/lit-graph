S2_API_KEY=
S2_MIN_INTERVAL_MS=1100
PORT=3001
S2_API_BASE_URL=https://api.semanticscholar.org/graph/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
REVIEW_MAX_PAPERS=10
REVIEW_MAX_SOURCE_CHARS_PER_PAPER=12000

# Optional semantic evidence checks. off, shadow (evaluate only), or on.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_REVIEW_MODE=off
TYPESAFE_AUDIT_MODE=off
# Provisional conservative threshold; calibrate on your sources before rollout.
TYPESAFE_REVIEW_MIN_CONFIDENCE=0.9

# Manuscript audits reuse ANTHROPIC_API_KEY and ANTHROPIC_MODEL above.
# Local development reads the running Zotero app without an API key.
ZOTERO_MODE=local
# Hosted deployments: set ZOTERO_MODE=web and configure a read-only library key.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_GROUP_ID=
# Required for remote access to manuscript audits; optional on localhost.
AUDIT_ACCESS_TOKEN=
