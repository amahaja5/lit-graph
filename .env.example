S2_API_KEY=
S2_MIN_INTERVAL_MS=1100
PORT=3001
S2_API_BASE_URL=https://api.semanticscholar.org/graph/v1

# Citation checking: TypeSafe judges whether retrieved source passages support each claim.
# Required for "Check citations". Citation extraction uses GROBID (GROBID_API_URL below).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Minimum TypeSafe confidence for a passage verdict to count (0-1). Lower-confidence
# judgements are reported as insufficient evidence. Calibrate on your sources.
TYPESAFE_VERDICT_MIN_CONFIDENCE=0.6
# Semantic ranking of source passages before judging: off (keyword ranking), shadow, or on.
TYPESAFE_AUDIT_MODE=off

# Local development reads the running Zotero app without an API key.
ZOTERO_MODE=local
# Hosted deployments: set ZOTERO_MODE=oauth. Users connect through Zotero.
# Register at https://www.zotero.org/oauth/apps
# Callback: <ZOTERO_OAUTH_ORIGIN>/api/zotero/callback
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
ZOTERO_OAUTH_ORIGIN=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this 64-character hex secret stable across server instances; never expose it in frontend code.
ZOTERO_SESSION_SECRET=
# Optional group library for local desktop mode only. OAuth currently uses personal libraries.
ZOTERO_GROUP_ID=
# Required for remote access to manuscript audits; optional on localhost.
AUDIT_ACCESS_TOKEN=

# Contact address sent to Crossref with reference lookups. Joins Crossref's "polite" pool:
# 3 searches/s and 3 concurrent instead of 1/s and 1. Leave blank to use the public pool.
CROSSREF_MAILTO=
# Address shown by the landing page's "Request access" button. Falls back to CROSSREF_MAILTO.
ACCESS_REQUEST_EMAIL=

# PDF bibliography extraction via the GROBID wrapper (server-only)
GROBID_API_URL=
EXTRACTION_API_KEY=
# Warm-up ping sent on sign-in / import-panel open so a scale-to-zero deployment
# (e.g. Cloud Run with min instances 0) starts before the user clicks Extract.
# Any non-5xx answer counts as awake. The wrapper's /health returns 503 until GROBID is up.
GROBID_WARM_PATH=/health
GROBID_WARM_WAIT_MS=8000

# Use Zotero OAuth sessions to unlock processing; deny accounts outside this list.
APP_AUTH_MODE=zotero
ZOTERO_ALLOWED_USERS=
